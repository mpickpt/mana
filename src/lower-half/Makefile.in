# @configure_input@

# The compilers and flags that configure found.
CFLAGS = @CFLAGS@
CXXFLAGS = @CXXFLAGS@
MPICXX = @MPICXX@ -std=c++20

# MANA_ROOT and DMTCP_ROOT in the environment replace these.
ifndef MANA_ROOT
  MANA_ROOT=@top_srcdir@
endif
ifndef DMTCP_ROOT
  DMTCP_ROOT=${MANA_ROOT}/dmtcp
endif

DMTCP_INCLUDE=${DMTCP_ROOT}/include
JALIB_INCLUDE=${DMTCP_ROOT}/jalib
MANA_INCLUDE=${MANA_ROOT}/src

DMTCP_DEPS = ${DMTCP_ROOT}/src/libdmtcprestart.a \
	     ${DMTCP_ROOT}/src/libdmtcpinternal.a \
	     ${DMTCP_ROOT}/src/libjalib.a \
	     ${DMTCP_ROOT}/src/libnohijack.a

override CFLAGS += -fPIC -I${DMTCP_INCLUDE} -I${MANA_INCLUDE} -g3 -O0 \
                   -I${DMTCP_ROOT}/src 
override CXXFLAGS += -fPIC -I${DMTCP_INCLUDE} -I${JALIB_INCLUDE} -I${MANA_INCLUDE} -I${DMTCP_ROOT}/src/mtcp \
                     -I${DMTCP_ROOT}/src

TEXTSEG_ADDR_FLAG=-Wl,-Ttext-segment=0x10000000

default: lower-half

# -MMD -MP writes the headers that an object includes into its .d file,
# which make reads below.  So a change to a header rebuilds the objects
# that include it.
.cpp.o:
	${MPICXX} ${CXXFLAGS} -MMD -MP -c -o $@ $<

.c.o:
	${MPICXX} ${CFLAGS} -MMD -MP -c -o $@ $<

# libmana.so links switch-context.o too.  So build it as the other objects
# of libmana.so are built: without the stack protector, because the code
# switches the FS register, and without the C++ bindings of mpi.h.
switch-context.o: switch-context.cpp
	${MPICXX} ${CXXFLAGS} -fno-stack-protector -DOMPI_SKIP_MPICXX \
	  -DMPICH_SKIP_MPICXX -MMD -MP -c -o $@ $<

-include $(wildcard *.d)

# Normally, gcc (or clang) will automatically link with libatomic.so.
# However, for come MPICXX it's hard to know if they cover it.
# So this is good as a safety measure.
lower-half: get-symbol-offset.o build-id-debug.o copy-stack.o patch-trampoline.o lh-func-ptr.o mem-wrapper.o switch-context.o lower-half.o mmap-fixed-noreplace.o ${DMTCP_DEPS}
	${MPICXX} ${TEXTSEG_ADDR_FLAG} ${CXXFLAGS} -o $@ $^ -lpthread -ldl -latomic

stage: lower-half
	cp -f $^ ${MANA_ROOT}/bin/

tidy:
	rm -f *~ .*.swp dmtcp_restart_script*.sh ckpt_*.dmtcp
	rm -rf ckpt_rank_*
	rm -rf dmtcp_coordinator_db-*.json

clean: tidy
	rm -f lower-half
	rm -f ${MANA_ROOT}/bin/lower-half
	rm -f *.o *.d

distclean: clean

.PHONY: default clean distclean stage

# Regenerate this Makefile when Makefile.in or config.status is newer.
Makefile: Makefile.in @top_builddir@/config.status
	cd @top_builddir@ && ./config.status src/lower-half/Makefile
