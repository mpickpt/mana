prefix=@prefix@
exec_prefix=@exec_prefix@
datarootdir=@datarootdir@
mandir=@mandir@
PANDOC=@PANDOC@
INSTALL = @INSTALL@
INSTALL_DATA = @INSTALL_DATA@

MANPAGES = mana.1.gz

default: ${MANPAGES}

%.1: %.1.md
	@- if test "$(PANDOC)" = "no" ; then \
	     echo "Skipping manpage generation; using pregenerated copy."; \
	   else \
	     $(PANDOC) -s -o $@ $<; \
	   fi

%.1.gz: %.1
	gzip --force --keep $<

install: ${MANPAGES}
	$(INSTALL) -d $(DESTDIR)$(mandir)/man1
	${INSTALL_DATA} ${MANPAGES} $(DESTDIR)$(mandir)/man1

# Quote each path: a space in it must not split it into other files' names.
uninstall:
	for f in $(MANPAGES); do rm -f "$(DESTDIR)$(mandir)/man1/$$f"; done

clean:
	rm -f *.1.gz

distclean: clean
	rm -f Makefile

# Regenerate this Makefile when Makefile.in or config.status is newer.
Makefile: Makefile.in @top_builddir@/config.status
	cd @top_builddir@ && ./config.status manpages/Makefile
