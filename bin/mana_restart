#!/usr/bin/env python3
import sys
import os
import shutil

help_msg = '''
  USAGE: [srun/mpirun] mana_restart [--verbose] [--timing] [DMTCP_OPTIONS ...]
                                    [--restartdir DIR] [--ckptdir DIR]
          For DMTCP options, do: dmtcp_restart --help
'''

# dmtcp options that requires a value
verbose = False
gdb = False
mana_root_path = os.path.dirname(os.path.realpath(__file__)) + "/../"

dmtcp_flags = sys.argv[1:]

# Special arguments
if "--gdb" in dmtcp_flags:
  gdb = True
  dmtcp_flags.remove("--gdb")
if "--help" in dmtcp_flags:
  print(help_msg)
  sys.exit(1)
if "--verbose" in dmtcp_flags:
  verbose = True
  dmtcp_flags.remove("--verbose")
if "--timing" in dmtcp_flags:
  os.environ["MANA_TIMING"] = "1"
  dmtcp_flags.remove("--timing")
if "--restartdir" not in dmtcp_flags:
  dmtcp_flags.extend(["--restartdir", "./"])
restartdir_index = dmtcp_flags.index("--restartdir")
if restartdir_index + 1 >= len(dmtcp_flags):
  print("mana_restart: --restartdir requires a directory")
  sys.exit(1)
restart_dir = os.path.abspath(
  os.path.expanduser(dmtcp_flags[restartdir_index + 1]))
if not os.path.isdir(restart_dir):
  print("mana_restart: --restartdir " + restart_dir +
        ": Restart directory doesn't exist")
  sys.exit(1)
# DMTCP writes each image to <image>.temp and renames it when it is complete.
for rank_entry in os.scandir(restart_dir):
  if not rank_entry.is_dir():
    continue
  for entry in os.scandir(rank_entry.path):
    if entry.name.endswith(".temp"):
      print("mana_restart: --restartdir " + restart_dir +
            ": Restart directory has .temp files.")
      print("Previous checkpoint may be incomplete.")
      sys.exit(1)
# The lower half replaces "--restartdir DIR" with the rank's image, and
# DMTCP stops parsing options at the image.  So keep the pair last.
del dmtcp_flags[restartdir_index:restartdir_index + 2]
dmtcp_flags.extend(["--restartdir", restart_dir])
# The new lower half starts MPI for the checkpoint's MANA_P2P_WAIT, which
# header.mana ("name=value" lines) records as p2p_wait, and keeps free the fd
# numbers that its rank had open (fds), for DMTCP's restore.  If the launcher
# does not tell the rank, it keeps free those of all ranks.

def read_header(header):
  with open(header, errors="replace") as f:
    return dict(line.strip().split("=", 1) for line in f if "=" in line)

headers = []
for var in ("PMI_RANK", "PMIX_RANK", "SLURM_PROCID"):
  if os.environ.get(var, "").isdigit():
    own = os.path.join(restart_dir, "ckpt_rank_" + os.environ[var],
                       "header.mana")
    if os.path.isfile(own):
      headers = [own]
    break
if not headers:
  for rank_dir in sorted(os.listdir(restart_dir)):
    header = os.path.join(restart_dir, rank_dir, "header.mana")
    if os.path.isfile(header):
      headers.append(header)
p2p_wait = None
# reserved_fds: fd numbers open at checkpoint (fds= from save_mana_header()).
# DMTCP's restore dup2()s the upper half's fds back onto them, closing any fd
# the new lower half already opened there.
reserved_fds = set()
for header in headers:
  fields = read_header(header)
  if p2p_wait is None and fields.get("p2p_wait") in ("polling", "blocking"):
    p2p_wait = fields["p2p_wait"]
  reserved_fds.update(int(x) for x in fields.get("fds", "").split(",")
                      if x.isdigit())
if p2p_wait is not None:
  os.environ["MANA_P2P_WAIT"] = p2p_wait
if reserved_fds:
  os.environ["MANA_RESERVED_FDS"] = ",".join(map(str, sorted(reserved_fds)))
if "--ckptdir" in dmtcp_flags:
  ckptdir_path = dmtcp_flags[dmtcp_flags.index("--ckptdir") + 1]
  if not os.path.exists(ckptdir_path):
    print("mana_restart: --ckptdir " + ckptdir_path + ": Checkpoint directory doesn't exist")
    sys.exit(1)
if "--quiet" in dmtcp_flags or "-q" in dmtcp_flags:
  os.environ["MANA_QUIET"] = "1"
  if "--quiet" in dmtcp_flags:
    dmtcp_flags.remove("--quiet")
  else:
    dmtcp_flags.remove("-q")

# # At higher ranks, restarting NIMROD causes a heap overflow (for a more detailed
# # write up, refer to Section 4 of mpi-proxy-split/doc/nimrod-build-tutorial.txt).
# # A temporary workaround is to swap the memory addresses of NIMROD and lh_proxy,
# # which requires a specially built version of lh_proxy.
# if echo $target_app | grep -q nimrod ; then
#   export USE_LH_PROXY_DEFADDR=1
# fi

# Find the .mana.rc file to get the hostname and port of the coordinator
rc_filename = ""
host_flag = ""
port_flag = ""
if "SLURM_JOB_ID" in os.environ:
  rc_filename = os.path.expanduser("~/.mana-slurm-" + os.environ["SLURM_JOB_ID"] + ".rc")
else:
  rc_filename = os.path.expanduser("~/.mana.rc")
rc_file = open(rc_filename)
for line in rc_file:
  line = line.split()
  if not line:
    continue
  if line[0] == "Host:":
    host_flag = " -h " + line[1] + " "
  elif line[0] == "Port:":
    port_flag = " -p " + line[1] + " "
rc_file.close()

# Remove old ~/.mana_*.rc files from a week ago or more.
os.system("find $HOME/.mana*.rc -ignore_readdir_race -maxdepth 0 -mtime +7 -type f -delete")

# Check dmtcp coordinator
coordinator_found = os.system(mana_root_path + "bin/dmtcp_command -s " + host_flag + port_flag + " >/dev/null 2>&1")
if coordinator_found != 0:
  print("No MANA coordinator detected. Try:")
  print("  " + mana_root_path + "bin/dmtcp_coordinator")
  print("Or:")
  print("  " + mana_root_path + "bin/dmtcp_coordinator --exit-on-last -q --daemon")
  sys.exit(1)

# Build the command line to be executed
if not verbose:
  dmtcp_flags.insert(0, "-q -q")
if gdb:
  cmd_line = shutil.which("gdb") + " --args "
else:
  cmd_line = ""
cmd_line += mana_root_path + "bin/lower-half -j --restore " + host_flag + port_flag + " ".join(dmtcp_flags)
if verbose:
  print(cmd_line)

# This is for debug only
# cmd_line = "/usr/bin/echo " + cmd_line
os.execv(cmd_line.split()[0], cmd_line.split())
