# The dmtcp submodule has a .gitignore of its own.

# Made by ./configure and autoreconf.
/Makefile
/manpages/Makefile
/config.log
/config.status
/aclocal.m4
/autom4te.cache/

# Made by make.  bin/ also gets DMTCP's programs and the lower half, but the
# mana_* launchers are sources.
/bin/*
!/bin/mana_*
/lib/
/manpages/mana.1.gz
*.[oa]
*.d
*.so
*.so.*
*.mod
*.dirstamp
*.pyc
__pycache__/

# Left by runs in the tree.
ckpt_*.dmtcp
ckpt_rank_*/
dmtcp_restart_script*
dmtcp_coordinator_db-*.json
core
core.*
*.log

# Editors and code browsers.
*~
*.swp
*.swo
cscope.*
GPATH
GRTAGS
GTAGS
.idea/
