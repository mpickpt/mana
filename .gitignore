# The dmtcp submodule has a .gitignore of its own.

# Made by ./configure and autoreconf.
/Makefile
/manpages/Makefile
/src/Makefile
/src/lower-half/Makefile
/src/mpi-wrappers/Makefile
/test/Makefile
/examples/Makefile
/bench/Makefile
/config.log
/config.status
/aclocal.m4
/autom4te.cache/

# Made by make.
/bin/
/lib/
/manpages/mana.1.gz
/src/lower-half/lower-half
/examples/ring
/bench/virtid_bench
/bench/synthetic_app
*.[oa]
*.d
*.so
*.so.*
*.mod
*.dirstamp
*.pyc
__pycache__/

# Made by src/mpi-wrappers/Makefile from the generate-*.py scripts.
/src/mpi-wrappers/mpi_fortran_wrappers.cpp
/src/mpi-wrappers/mpi_unimplemented_wrappers.cpp
/src/mpi-wrappers/mpi_stub_wrappers.c
/src/mpi-wrappers/mpi_stub_objects.c
/src/mpi-wrappers/*.tmp.*

# The programs of the end-to-end tests have no suffix:
# ignore all but the sources.
/test/*
!/test/*.c
!/test/*.cpp
!/test/*.f90
!/test/*.h
!/test/*.py
!/test/*.md
!/test/Makefile.in

# Left by runs in the tree.
ckpt_*.dmtcp
ckpt_rank_*/
dmtcp_restart_script*
dmtcp_coordinator_db-*.json
core
core.*
*.log

# Editors and code browsers.
*~
*.swp
*.swo
cscope.*
GPATH
GRTAGS
GTAGS
.idea/
